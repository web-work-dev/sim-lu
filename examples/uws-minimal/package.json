{
    "name": "uws-minimal",
    "version": "1.0.0",
    "description": "Minimal example: run an HTTP server with @sim-lu/platform-uws (uWebSockets.js)",
    "type": "module",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsc && node dist/index.js",
        "build": "tsc"
    },
    "dependencies": {
        "@sim-lu/common": "workspace:*",
        "@sim-lu/core": "workspace:*",
