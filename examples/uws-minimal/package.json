        "@sim-lu/error": "workspace:*",
        "@sim-lu/platform-uws": "workspace:*",
        "uWebSockets.js": "github:uNetworking/uWebSockets.js"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
